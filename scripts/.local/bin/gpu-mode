#!/bin/sh

set -u

CONFIG="$HOME/.config/niri/gpu-mode.kdl"
MODES="$HOME/.config/niri/gpu-modes"
VM="voidlinux-base-niri"

GPU="0000:01:00.0"
GPU_SHORT="01:00.0"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gpu-mode"
VFIO_BOOT_FILE="$STATE_DIR/vfio-boot-id"

# ============================================================
# Boot / VFIO history
# ============================================================

current_boot_id() {
  cat /proc/sys/kernel/random/boot_id
}

mark_vfio_this_boot() {
  mkdir -p "$STATE_DIR"
  current_boot_id >"$VFIO_BOOT_FILE"
}

vfio_used_this_boot() {
  [ -f "$VFIO_BOOT_FILE" ] || return 1

  saved_boot="$(cat "$VFIO_BOOT_FILE" 2>/dev/null || true)"
  current_boot="$(current_boot_id)"

  [ "$saved_boot" = "$current_boot" ]
}

# ============================================================
# GPU state
# ============================================================

gpu_driver() {
  if [ -L "/sys/bus/pci/devices/$GPU/driver" ]; then
    basename "$(readlink "/sys/bus/pci/devices/$GPU/driver")"
  else
    echo "none"
  fi
}

vm_state() {
  virsh -c qemu:///system domstate "$VM" 2>/dev/null | tr -d '\r'
}

configured_mode() {
  if [ ! -f "$CONFIG" ]; then
    echo "UNKNOWN"
  elif grep -q 'ignore-drm-device' "$CONFIG"; then
    echo "VFIO"
  else
    echo "HDMI"
  fi
}

nvidia_users() {
  sudo lsof /dev/nvidia* 2>/dev/null || true
}

niri_uses_nvidia() {
  nvidia_users | awk '$1 == "niri" { found=1 } END { exit !found }'
}

any_nvidia_users() {
  [ -n "$(nvidia_users)" ]
}

hdmi_state() {
  for f in /sys/class/drm/card*-HDMI-A-*/status; do
    [ -e "$f" ] || continue

    dev="$(readlink -f "$(dirname "$f")/device" 2>/dev/null || true)"

    case "$dev" in
    *0000:01:00.0*)
      cat "$f"
      return
      ;;
    esac
  done

  echo "unknown"
}

# ============================================================
# Status
# ============================================================

show_status() {
  MODE="$(configured_mode)"
  DRIVER="$(gpu_driver)"
  VMSTATE="$(vm_state)"
  HDMI="$(hdmi_state)"
  USERS="$(nvidia_users)"

  echo "========== GPU MODE STATUS =========="
  echo
  echo "Configured mode : $MODE"
  echo "GPU driver      : $DRIVER"
  echo "VM state        : $VMSTATE"
  echo "HDMI            : $HDMI"

  if vfio_used_this_boot; then
    echo "VFIO this boot  : YES"
  else
    echo "VFIO this boot  : NO"
  fi

  echo
  echo "=== NVIDIA USERS ==="

  if [ -n "$USERS" ]; then
    printf '%s\n' "$USERS"
  else
    echo "none"
  fi

  echo
  echo "=== VFIO ==="

  if printf '%s\n' "$VMSTATE" | grep -qi '^running'; then
    mark_vfio_this_boot

    if [ "$DRIVER" = "vfio-pci" ]; then
      echo "ACTIVE: VM currently owns the T1000."
    else
      echo "WARNING: VM is running but GPU driver is '$DRIVER'."
    fi

  elif [ "$MODE" != "VFIO" ]; then
    echo "NOT READY: configured mode is HDMI."
    echo "Run:"
    echo "  gpu-mode vfio"

  elif niri_uses_nvidia; then
    echo "NOT READY: Niri still owns the NVIDIA GPU."
    echo "Restart the Niri session."

  elif any_nvidia_users; then
    echo "NOT READY: another process is using NVIDIA."
    echo "Close the process shown above."

  elif [ "$DRIVER" != "nvidia" ]; then
    echo "NOT READY: expected host driver 'nvidia', got '$DRIVER'."

  else
    echo "READY: you can start the VFIO VM."
    echo
    echo "  virsh -c qemu:///system start $VM"
  fi

  echo
  echo "=== HDMI HOST MODE ==="

  if printf '%s\n' "$VMSTATE" | grep -qi '^running'; then
    echo "NOT READY: VM currently owns the NVIDIA GPU."
    echo "Shut down the VM first."

  elif vfio_used_this_boot; then
    echo "UNSAFE: NVIDIA has entered the VFIO workflow during this boot."
    echo
    echo "The GPU may return to the nvidia driver, but its DRM/KMS"
    echo "display state is not reliable after VFIO."
    echo
    echo "Connecting HDMI in this state may cause both displays"
    echo "to go black."
    echo
    echo "REBOOT REQUIRED before using HDMI."

  elif [ "$DRIVER" != "nvidia" ]; then
    echo "NOT READY: NVIDIA is not attached to the host driver."
    echo "Current driver: $DRIVER"

  elif [ "$MODE" = "HDMI" ] && niri_uses_nvidia; then
    echo "ACTIVE: Niri is using the NVIDIA GPU."

    if [ "$HDMI" = "connected" ]; then
      echo "HDMI monitor is connected."
    else
      echo "HDMI monitor is not currently detected."
    fi

  elif [ "$MODE" = "HDMI" ]; then
    echo "PENDING: HDMI profile is selected, but Niri has not attached to NVIDIA."
    echo "Restart the Niri session."

  else
    echo "READY TO SWITCH: GPU belongs to the host."
    echo "Run:"
    echo "  gpu-mode hdmi"
    echo "Then restart the Niri session."
  fi

  echo
  echo "====================================="
}

# ============================================================
# Commands
# ============================================================

case "${1:-}" in
vfio)
  state="$(vm_state)"

  if printf '%s\n' "$state" | grep -qi '^running'; then
    mark_vfio_this_boot
    echo "VFIO is already active: VM is running."
    exit 0
  fi

  cp "$MODES/vfio.kdl" "$CONFIG"
  sleep 1

  if niri_uses_nvidia; then
    echo "VFIO profile selected."
    echo "Niri still owns NVIDIA."
    echo
    echo "Restart Niri:"
    echo "  niri msg action quit --skip-confirmation"
    echo
    echo "Then from the TTY:"
    echo "  start-niri"
    exit 2
  fi

  if any_nvidia_users; then
    echo "VFIO profile selected, but NVIDIA is still in use:"
    nvidia_users
    exit 1
  fi

  #
  # From this point onward we consider this boot unsafe
  # for HDMI. The expected next action is starting the VM,
  # which will bind the T1000 to vfio-pci.
  #
  mark_vfio_this_boot

  echo "OK: NVIDIA is free for VFIO."
  echo
  echo "NOTE: HDMI host mode will require a reboot after this."
  ;;

hdmi)
  state="$(vm_state)"

  if printf '%s\n' "$state" | grep -qi '^running'; then
    mark_vfio_this_boot

    echo "ERROR: VM is running and owns the NVIDIA GPU."
    echo "Shut down the VM first."
    exit 1
  fi

  if vfio_used_this_boot; then
    echo "ERROR: HDMI mode is unsafe during this boot."
    echo
    echo "The T1000 has entered the VFIO workflow."
    echo "Although the GPU may currently be attached to 'nvidia',"
    echo "its DRM/KMS display state may be corrupted."
    echo
    echo "Connecting HDMI can cause both displays to go black."
    echo
    echo "Reboot before enabling HDMI mode."
    exit 1
  fi

  if [ "$(gpu_driver)" != "nvidia" ]; then
    echo "ERROR: NVIDIA is not attached to the host driver."
    echo "Current driver: $(gpu_driver)"
    exit 1
  fi

  cp "$MODES/hdmi.kdl" "$CONFIG"
  sleep 1

  if niri_uses_nvidia; then
    echo "OK: HDMI mode is active."
  else
    echo "HDMI profile selected."
    echo "Restart Niri:"
    echo "  niri msg action quit --skip-confirmation"
    echo
    echo "Then from the TTY:"
    echo "  start-niri"
  fi
  ;;

status)
  show_status
  ;;

*)
  echo "Usage: gpu-mode {vfio|hdmi|status}"
  exit 1
  ;;
esac
