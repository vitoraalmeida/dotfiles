// niri compositor config — KDL format (https://kdl.dev). "/-" comments out the next node.
// Docs: https://niri-wm.github.io/niri
// Most settings hot-reload on save. Exceptions: spawn-at-startup lines and some input
// settings only apply at niri startup.
// Bottom of file includes: noctalia.kdl (theme colors, auto-generated) and gpu-mode.kdl (render device).

// Client-side decorations off: niri draws borders/titlebars instead of the app.
prefer-no-csd

// Autostart. Runs ONLY at niri startup — reloading the config does not restart these.
spawn-at-startup "pipewire"                                          // audio/video server; nothing audio-related works without it
spawn-at-startup "sh" "-c" "sleep 2; exec wireplumber"               // pipewire session manager (volume routing, devices); 2s delay so pipewire's socket exists first
spawn-at-startup "/home/user/.local/bin/niri-session-services"    // desktop integration script from install-niri-noctalia.sh

input {
    keyboard {
        repeat-rate 35        // keys per second while holding a key; higher = faster typing repeat
        repeat-delay 200      // ms a key must be held before repeating starts; lower = sooner
        xkb {
            layout "br"           // Brazilian ABNT2 layout; change requires niri restart in some cases
            variant "thinkpad"    // layout variant; remove if you switch layouts and keys feel wrong
        }

        numlock               // force NumLock on at startup
    }

    touchpad {
        tap                   // tap-to-click. Uncomment "natural-scroll" to invert two-finger scroll direction.
    }

    trackpoint {
        // All options disabled (defaults): off, natural-scroll, accel-speed 0.2,
        // accel-profile "flat", scroll-method "on-button-down", scroll-button 273,
        // scroll-button-lock, middle-emulation. Uncomment to override.
    }

    // Hovering a window focuses it. max-scroll-amount="0%" = focusing never auto-scrolls the view.
    focus-follows-mouse max-scroll-amount="0%"
}

// Disabled output config (whole block commented with /-). If ever enabled:
//   mode: resolution@refresh Hz. scale 2: HiDPI doubling — logical size becomes physical/2.
//   position x= y=: manual placement in the global coordinate space; unset/overlapping = auto-placed.
//   Output scale/transform affect logical size (use logical px when positioning neighbors).
/-output "eDP-1" {
    // off                     // uncomment to disable this output entirely
    mode "1920x1080@120.030"  // "WIDTHxHEIGHT@REFRESH"
    scale 2                   // HiDPI zoom: 2 = everything twice as big, half the logical pixels
    transform "normal"        // rotation: "normal" | "90" | "180" | "270" | flipped variants
    position x=1280 y=0       // manual position; remove to auto-place
}

// Window layout. https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    gaps 6                          // space between windows and screen edges, in logical px
    background-color "transparent"  // compositor background; "transparent" shows the wallpaper behind

    center-focused-column "never"   // "never" | "always" | "on-overflow": keep the focused column centered

    preset-column-widths {          // widths cycled with Mod+R, as fractions of monitor width
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }  // width of new windows; {} = let the app decide

    focus-ring {
        width 1                     // thickness of the focused-window ring in logical px; colors live in noctalia.kdl
    }

    border {
        width 1                     // thickness of the border around unfocused windows; colors live in noctalia.kdl
    }

    shadow {
        on                          // delete this line to disable drop shadows
        softness 30                 // blur size; higher = softer, wider shadow
        spread 5                    // how far the shadow extends past the window edges
        offset x=0 y=5              // shadow displacement; y=5 pushes it down
        color "#0007"               // RRGGBBAA — black at ~44% opacity
    }
}

// Environment variables for processes niri spawns.
environment {
    // App lookup paths; the Flatpak entries make installed Flatpaks resolvable.
    // Only change if apps fail to launch or find their resources.
    XDG_DATA_DIRS "/usr/local/share:/usr/share:/var/lib/flatpak/exports/share:/home/user/.local/share/flatpak/exports/share"
}

debug {
    // Tolerate apps that send XDG activation tokens with invalid serials; prevents focus quirks
    // in buggy clients. Remove if apps start stealing focus unexpectedly.
    honor-xdg-activation-with-invalid-serial
}

layer-rule {
    match namespace="^noctalia-wallpaper"  // matches noctalia's wallpaper surface
    place-within-backdrop true             // render it in the backdrop (behind everything, visible in overview gaps)
}

// Window rules. First matching rule wins per setting. app-id values are case-sensitive regexes.
// Docs: https://niri-wm.github.io/niri/Configuration:-Window-Rules

// Dim unfocused windows slightly. 1.0 = no dimming; lower = darker.
window-rule {
    match is-active=false
    opacity 0.95
}

// Alacritty terminal: let the ring render over the terminal background and enable blur-behind.
window-rule {
    match app-id="^Alacritty$"
    draw-border-with-background false

    background-effect {
        xray true   // blur with "xray" mode (blurs behind while keeping content sharp)
    }
}

// Firefox Picture-in-Picture opens floating. The regex matches host and Flatpak Firefox
// (app-ids "firefox" and "org.mozilla.firefox").
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Noctalia's own windows (e.g. its settings/editor surfaces) open floating.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}

// Rounded corners everywhere: radius 12 logical px on all windows, and windows are clipped to
// the rounded shape (otherwise corners would just paint over square content).
window-rule {
    geometry-corner-radius 7
    clip-to-geometry true
}

// Example: hide KeePassXC/Secrets from screen capture. Currently disabled (/-).
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Where Print screenshots are saved. %Y %m %d %H %M %S = strftime time tokens.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

binds {
    // Noctalia IPC — "noctalia msg" talks to the running shell.
    Mod+Space hotkey-overlay-title="Noctalia Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Noctalia Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+S hotkey-overlay-title="Noctalia Settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Alt+Tab hotkey-overlay-title="Noctalia Window Switcher" { spawn "noctalia" "msg" "window-switcher"; }
    Mod+Shift+Escape hotkey-overlay-title="Session Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Super+Alt+H hotkey-overlay-title="Lock and Hibernate" { spawn-sh "noctalia msg session lock; sleep 1; loginctl hibernate"; }

    // Popup listing all binds (also the on-screen cheatsheet).
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Super+Alt+L hotkey-overlay-title="Lock: Noctalia" { spawn "noctalia" "msg" "session" "lock"; }

    // Toggle the Orca screen reader on/off (pkill exits it, otherwise start it).
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // Media/volume/brightness keys. allow-when-locked=true = also work on the lock screen.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Overview: zoomed-out view of workspaces/windows. Also via top-left hot corner or
    // four-finger swipe up. repeat=false = ignore auto-repeat when held.
    Mod+O repeat=false { toggle-overview; }

    Mod+Q repeat=false { close-window; }

    // Focus: arrows + hjkl (columns move horizontally, windows vertically within a column).
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    // Same keys with Ctrl: move instead of focus.
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    // Alternative cross-workspace focus/move when hitting column edges:
    // Mod+J { focus-window-or-workspace-down; }   Mod+K { focus-window-or-workspace-up; }
    // Mod+Ctrl+J { move-window-down-or-to-workspace-down; }   Mod+Ctrl+K { move-window-up-or-to-workspace-up; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // Focus monitors (arrows or Shift+hjkl).
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    // Move the focused column to another monitor.
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // Workspace navigation: PageUp/PageDown or U/I; Ctrl variants carry the column along.
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+I              { focus-workspace-down; }
    Mod+U              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+I         { move-column-to-workspace-down; }
    Mod+Ctrl+U         { move-column-to-workspace-up; }

    // Move only the window, keeping the column behind:
    // Mod+Ctrl+Page_Down { move-window-to-workspace-down; }

    // Reorder workspaces themselves.
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // Mouse wheel over the background: switch workspaces. cooldown-ms rate-limits each tick
    // to avoid flying through workspaces. Ctrl variants move the column too.
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Horizontal wheel = column navigation.
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Shift+wheel replicates horizontal scroll like in apps.
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Touchpad scroll binds (continuous input split into ticks); disabled here:
    // Mod+TouchpadScrollDown/Up — direction follows the touchpad natural-scroll setting.

    // Numbered workspaces. niri workspaces are dynamic: an index beyond existing workspaces
    // targets the bottommost empty one, so 1–9 always behave sanely.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Move just the window, keeping the column behind:
    // Mod+Ctrl+1 { move-window-to-workspace 1; }
    // Mod+Tab { focus-workspace-previous; }

    // Merge/extract windows between columns: a lone window joins the neighbor column;
    // a window inside a column is expelled out of it.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    Mod+Comma  { consume-window-into-column; }   // pull the window from the right into this column
    Mod+Period { expel-window-from-column; }     // push the bottom window out to the right

    // Cycle the preset-column-widths (Shift = reverse). Window-height variants only matter
    // inside a column with multiple windows.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }        // column takes the monitor width, gaps/borders kept
    Mod+Shift+F { fullscreen-window; } // true fullscreen: no bars, gaps, or borders

    Mod+M { maximize-window-to-edges; } // window fills the screen edge-to-edge (like double-click maximize)

    Mod+Ctrl+F { expand-column-to-available-width; } // grow the column into free space

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Width/height steps; also accepts absolute px ("1000"), px deltas ("+5"),
    // and percent ("25%", "-10%"). Pixels are logical (scale 2 doubles physical size).
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Floating/tiling: Mod+V floats or tiles the window; Mod+Shift+V jumps focus between layers.
    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Tabs within a column: windows stack vertically as tabs.
    Mod+W { toggle-column-tabbed-display; }

    // Layout switching via xkb (disabled here). If enabled, do NOT also bind the same keys in
    // the xkb options — double switching breaks it (once by xkb, once by niri).
    // Mod+Space       { switch-layout "next"; }
    // Mod+Shift+Space { switch-layout "prev"; }

    Print { screenshot; }          // region picker
    Ctrl+Print { screenshot-screen; }  // whole monitor
    Alt+Print { screenshot-window; }   // focused window

    // Escape hatch: remote-desktop/KVM apps can inhibit niri's shortcuts; this toggles the
    // inhibitor off if an app holds it hostage. allow-inhibiting=false = this bind always works.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Quit shows a confirmation dialog first.
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // Monitor power-off; any input wakes the screens.
    Mod+Shift+P { power-off-monitors; }
}

// Desktop integration added by install-niri-noctalia.sh:
include "noctalia.kdl"   // theme colors (focus ring, border, shadow, tabs) — AUTO-GENERATED by Noctalia, don't hand-edit
include "gpu-mode.kdl"   // render device pin for hybrid graphics
